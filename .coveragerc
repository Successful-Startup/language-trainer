[run]
branch = True
# The start tests run manage.py in a new process. This measures that process too.
patch = subprocess
source =
    language_trainer_app
    language_trainer_project
omit =
    */tests/*
    */migrations/*
    language_trainer_project/wsgi.py
    language_trainer_project/asgi.py

[report]
# Replaces the default list, so "# pragma: no cover" excludes nothing.
exclude_lines =
    a^
# CI checks the gate on the sum of the SQLite and PostgreSQL runs.
fail_under = 100
precision = 2
show_missing = True
skip_covered = True
